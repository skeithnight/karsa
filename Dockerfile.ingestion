# =============================================================================
# Karsa Data Ingestion Worker — Production Dockerfile
# Multi-stage build: builder compiles deps, runtime is minimal.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Builder — install dependencies with uv
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS builder

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /build

# System deps for compiling psycopg[c] and cryptography
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq-dev \
        gcc \
        libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency manifests first (layer cache optimization)
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# Copy source and install the project itself
COPY src/ ./src/
COPY README.md ./
RUN uv sync --frozen --no-dev

# ---------------------------------------------------------------------------
# Stage 2: Runtime — minimal image, non-root user
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS runtime

# Runtime system deps (libpq for psycopg, ca-certificates for HTTPS)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get purge -y --auto-remove

# Create non-root user
RUN groupadd -r karsa && useradd -r -g karsa -d /app -s /sbin/nologin karsa

WORKDIR /app

# Copy the virtual environment from builder
COPY --from=builder /build/.venv /app/.venv

# Copy only the source code (no tests, no alembic, no node_modules)
COPY src/ /app/src/

# Ensure the venv is on PATH
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1

# Create directory for durable buffer (SQLite WAL)
RUN mkdir -p /data/karsa && chown -R karsa:karsa /data/karsa

# Switch to non-root user
USER karsa

# Expose health check port
EXPOSE 8080

# Docker HEALTHCHECK as fallback (K8s uses its own probes)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command — run the ingestion worker with health server
CMD ["python", "-m", "karsa.data_bridge.worker"]
